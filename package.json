{
  "name": "weather-activity-planner",
  "version": "1.0.0",
  "description": "AI-powered outdoor activity weather planner",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "nodemonConfig": {
    "watch": ["server.js", "public/", ".env"],
    "ext": "js,json,env",
    "ignore": ["node_modules/", "uploads/"]
  }
}
